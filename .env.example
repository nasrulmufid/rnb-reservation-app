# Environment Variables Template
# Copy this file to .env.local and update values as needed

# Database connection string
# For SQLite (development): file:./dev.db
# For production: postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Node.js environment
# development | staging | production
NODE_ENV="development"

# Next.js API URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Cookie security settings
# Set to false for HTTP localhost (development)
# Set to true for HTTPS production
SECURE_COOKIES="false"

# Optional: NextAuth URL (if using NextAuth in the future)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="generate-a-random-secret-for-production"
